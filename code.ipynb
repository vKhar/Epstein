    {
      "cell_type": "markdown",
      "id": "00ce6b9f",
      "metadata": {
        "id": "00ce6b9f"
      },
      "source": [
        "### Query MongoDB\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "3e5b2bd7",
      "metadata": {
        "id": "3e5b2bd7"
      },
      "outputs": [],
      "source": [
        "from pymongo import MongoClient\n",
        "\n",
        "client = MongoClient('mongodb://localhost:27017/')\n",
        "db = client['Epstein']\n",
        "col = db['docs']\n",
        "\n",
        "projection = {\n",
        "    \"_id\": 0,\n",
        "    \"identifier\":1,\n",
        "    \"people\": 1,\n",
        "    \"org\":1,\n",
        "    \"doc_type\":1,\n",
        "    \"date\":1\n",
        "    }"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "be9f9962",
      "metadata": {
        "id": "be9f9962"
      },
      "outputs": [],
      "source": [
        "### Sample Query 1:\n",
        "### find all docs that has EPSTEIN mentioned and org is DOJ\n",
        "name=\"EPSTEIN\"\n",
        "org=\"DOJ\"\n",
        "query = {\n",
        "    'people': {\n",
        "        '$in': [name]\n",
        "    },\n",
        "    'organizations':{\n",
        "        '$in': [org]\n",
        "    }\n",
        "}\n",
        "projection = {\n",
        "    \"_id\": 0,\n",
        "    \"identifier\":1,\n",
        "    \"people\":1,\n",
        "    \"organizations\":1\n",
        "    }\n",
        "for doc in collect.find(query, projection):\n",
        "    print( doc[\"identifier\"], end=\",\")\n",
        "    for i,p in enumerate(doc[\"people\"]):\n",
        "          if name in p:\n",
        "               print(doc[\"people\"][i], end=\",\")\n",
        "    for i,p in enumerate(doc[\"organizations\"]):\n",
        "        if org in p:\n",
        "            print(doc[\"organizations\"][i])\n",
        ""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "96d8d538",
      "metadata": {
        "id": "96d8d538"
      },
      "outputs": [],
      "source": [
        "## Sample Query 2\n",
        "## sort names of people that are most frquently mentioned in descending orer of reqeuncy\n",
        "people={}\n",
        "\n",
        "for person_array, doc_id in map(\n",
        "    lambda x: (x['people'],x['identifier']),\n",
        "    col.find(query, projection)\n",
        "):\n",
        "    for name in person_array:\n",
        "        people[name] = people.get(name, 0) + 1\n",
        "\n",
        "sorted (people.items(), key=lambda x:x[1], reverse=True)"
      ]
    },
