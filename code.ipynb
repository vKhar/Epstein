        "# docs=json.load(open(\"./data/documents_sample.json\",encoding=\"utf-8\"))\n",
        "# with open(\"./data/epstein.json\",\"w\") as f:\n",
        "#           f.write(json.dumps(docs))\n",
        "\n",
        "docs = json.load(open(\"epstein.json\"))\n",
        "db.drop_collection('docs')\n",
        "collect = db['docs']\n",
        "collect.insert_many(docs)"
      ]
