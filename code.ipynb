    "class Doc:\n",
    "    def __init__(self, doc_dict):\n",
    "        for key, value in doc_dict.items():\n",
    "            setattr(self, key, value)\n",
    "    def __repr__(self):\n",
    "        return f\"{self.__dict__[\"doc_id\"]}\"\n",
    "\n",
    "class HT_Doc:\n",
    "    size = 20\n",
    "    @classmethod\n",
    "    def _hash(cls, obj):\n",
    "        return hash(json.dumps(obj.__dict__))%HT_Doc.size\n",
    "    def __init__(self):\n",
    "        self.array = [ None for _ in range(HT_Doc.size)]\n",
    "    def insert(self, doc):\n",
    "        doc = Doc(doc)\n",
    "        index = HT_Doc._hash(doc)\n",
    "        cur = index\n",
    "        while True:\n",
    "            if self.array[cur] is None:\n",
    "                self.array[cur] = doc\n",
    "                return\n",
    "            cur = (cur + 1) % HT_Doc.size\n",
    "            if cur == index:\n",
    "                raise Exception(\"Hash table is full\")"
   ]
